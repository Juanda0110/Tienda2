<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.poligran.bugtracker.vista.ControladorFormulario">

    <top>
        <Label text="BugTracker-QA" style="-fx-font-size: 20px; -fx-padding: 10;" />
    </top>

    <center>
        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
            <TextField fx:id="txtId" promptText="ID" />
            <TextField fx:id="txtTitulo" promptText="Título" />
            <TextField fx:id="txtDescripcion" promptText="Descripción" />
            <TextField fx:id="txtPrioridad" promptText="Prioridad" />
            <TextField fx:id="txtEstado" promptText="Estado" />
            <Button text="Agregar Bug" onAction="#agregarBug" />
            <ListView fx:id="listaBugs" prefHeight="200" />
        </VBox>
    </center>
</BorderPane>
